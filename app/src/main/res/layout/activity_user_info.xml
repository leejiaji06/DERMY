<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserInfo"
    android:background="@color/pink_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_margin="15dp"
        android:padding="15dp">

        <TextView
            android:id="@+id/textView_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Information"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_title"
            android:id="@+id/textView_gender"
            android:text="Gender"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:textColor="#555555"
            android:textSize="16sp"/>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/radio_group_gender"
            android:layout_below="@id/textView_gender"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/user_info_radio_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Male"
                android:checked="false"
                android:textSize="16sp"
                android:textColor="#666666"/>

            <RadioButton
                android:id="@+id/user_info_radio_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Female"
                android:checked="true"
                android:textSize="16sp"
                android:textColor="#666666"/>

        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView_DOB"
            android:layout_below="@+id/radio_group_gender"
            android:text="Date of Birth"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:textColor="#555555"
            android:textSize="16sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editText_DOB"
            android:layout_below="@id/textView_DOB"
            android:hint="DD/MM/YYYY"
            android:padding="6dp"
            android:textSize="16sp"
            android:background="@drawable/border"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView_mobile"
            android:layout_below="@id/editText_DOB"
            android:text="Phone"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:textColor="#555555"
            android:textSize="16sp"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editText_mobile"
            android:layout_below="@id/textView_mobile"
            android:hint="eg. 0123456789"
            android:inputType="text"
            android:padding="6dp"
            android:textSize="16sp"
            android:background="@drawable/border"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textview_country"
            android:layout_below="@id/editText_mobile"
            android:text="Country"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:textColor="#555555"
            android:textSize="16sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editText_country"
            android:layout_below="@id/textview_country"
            android:hint="eg. MALAYSIA"
            android:inputType="textCapCharacters"
            android:padding="6dp"
            android:textSize="16sp"
            android:background="@drawable/border"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView_state"
            android:layout_below="@id/editText_country"
            android:text="State"
            android:layout_marginTop="30dp"
            android:padding="6dp"
            android:textColor="#555555"
            android:textSize="16sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editText_state"
            android:layout_below="@id/textView_state"
            android:hint="eg. PENANG"
            android:inputType="textCapCharacters"
            android:padding="6dp"
            android:textSize="16sp"
            android:background="@drawable/border"/>

        <Button
            android:id="@+id/button_upload_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/editText_state"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="70dp"
            android:backgroundTint="@color/theme_red_orange"
            android:text="Submit"
            app:cornerRadius="8dp" />

    </RelativeLayout>

</ScrollView>