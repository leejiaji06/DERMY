<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    android:background="@color/pink_background"
    tools:context=".UploadProfile">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/upload_pic_head"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Upload your profile pic"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:id="@+id/imageView_profile_dp"
        android:layout_margin="20dp"
        android:background="@drawable/border"
        android:layout_below="@+id/upload_pic_head"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="288dp"
        android:layout_height="57dp"
        android:layout_below="@id/imageView_profile_dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/upload_pic_choose_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/poppins_medium"
            android:text="Browse"
            android:textAlignment="center"
            android:textColor="@color/theme_brown"
            android:textSize="17sp"
            app:cornerRadius="8dp"
            app:strokeColor="#B6BFB8"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/upload_pic_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/theme_brown"
            android:fontFamily="@font/poppins_medium"
            android:text="Upload"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</RelativeLayout>