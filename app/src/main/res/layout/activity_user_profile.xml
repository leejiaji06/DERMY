<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_background"
    tools:context=".UserProfile">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#d3d3d3"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/base_background"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <View
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/top_background"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/profile"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="142dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="149dp"
                    android:background="@drawable/border"
                    android:backgroundTint="@color/theme_red_orange"
                    app:srcCompat="@drawable/profile" />

                <TextView
                    android:id="@+id/show_hello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/profile"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="24dp"
                    android:hint="@string/loading"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_update_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_below="@+id/show_hello"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="144dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="147dp"
                    android:layout_marginBottom="31dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Update"
                    android:textAlignment="center"
                    android:textColor="@color/theme_brown"
                    android:textSize="15sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#B6BFB8"
                    app:strokeWidth="1dp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="20dp"
                android:background="@color/white"
                android:padding="15dp">

                <ImageView
                    android:id="@+id/ic_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/outline_person_ic" />

                <TextView
                    android:id="@+id/show_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/ic_profile"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/divider_username"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/show_username"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/ic_email"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/divider_username"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/email_icon" />

                <TextView
                    android:id="@+id/show_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/divider_username"
                    android:layout_alignStart="@+id/ic_profile"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/divider_email"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/show_email"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/ic_dob"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/divider_email"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/calendar_icon" />

                <TextView
                    android:id="@+id/show_dob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/divider_email"
                    android:layout_alignStart="@+id/ic_dob"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/divider_dob"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/show_dob"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/ic_gender"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/divider_dob"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/female_icon" />

                <TextView
                    android:id="@+id/show_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/divider_dob"
                    android:layout_alignStart="@+id/ic_gender"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/divider_gender"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/show_gender"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/ic_phone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/divider_gender"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/phone_icon" />

                <TextView
                    android:id="@+id/show_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/divider_gender"
                    android:layout_alignStart="@+id/ic_phone"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/divider_phone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/show_phone"
                    android:layout_marginTop="30dp"
                    android:background="@android:color/darker_gray" />

                <ImageView
                    android:id="@+id/ic_country"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@id/divider_phone"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/country_icon" />

                <TextView
                    android:id="@+id/show_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/divider_phone"
                    android:layout_alignStart="@+id/ic_country"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="28dp"
                    android:hint="@string/loading"
                    android:textSize="18sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:elevation="10dp"
                    android:visibility="gone" />

            </RelativeLayout>


        </LinearLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>