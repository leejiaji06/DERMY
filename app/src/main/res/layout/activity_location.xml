<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LocationActivity">

   <fragment
       android:id="@+id/map"
       android:name="com.google.android.gms.maps.SupportMapFragment"
       android:layout_width="match_parent"
       android:layout_height="match_parent"/>

   <com.skyfishjy.library.RippleBackground
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:id="@+id/ripple_bg"
       app:rb_color="#0099CC"
       app:rb_radius="32dp"
       app:rb_rippleAmount="4"
       app:rb_duration="3000"
       app:rb_scale="6">

      <ImageView
          android:id="@+id/place_photo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:src="@drawable/loc_icon"
          android:translationY="-18dp"/>

      <com.mancj.materialsearchbar.MaterialSearchBar
          android:id="@+id/searchBar"
          style="@style/MaterialSearchBarLight"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="16dp"
          android:layout_alignParentTop="true"
          android:elevation="5dp"
          android:outlineProvider="bounds"
          app:mt_hint="Search for skin clinic nearby"
          app:mt_maxSuggestionsCount="10"
          app:mt_navIconEnabled="true"
          app:mt_placeholder="Search for skin clinic nearby"
          app:mt_speechMode="false" />

   </com.skyfishjy.library.RippleBackground>

   <Button
       android:id="@+id/btn_find"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_alignParentBottom="true"
       android:layout_margin="20dp"
       android:backgroundTint="@color/theme_red_orange"
       android:text="Find Skin Clinic"
       android:textSize="15sp"
       android:textColor="@color/white"
       android:textStyle="bold"
       app:cornerRadius="10dp" />

</RelativeLayout>
